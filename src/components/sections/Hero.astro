---
// Hero.astro — static shell, React islands hydrate client-side
import HeroText from "../hero/HeroText";
import HeroRight from "../hero/HeroRight";
---

<section
    id="hero"
    class="relative border-[#1e1e1e] border-b w-full max-w-full overflow-hidden lg:min-h-[calc(100vh-56px)]"
>
    <div
        class="flex flex-col w-full min-w-0 lg:grid lg:grid-cols-2 lg:min-h-[calc(100vh-56px)]"
    >
        <HeroText client:load />
        <HeroRight client:load />
    </div>

    <div
        class="bottom-6 left-6 md:left-12 absolute z-10 hidden sm:flex items-center gap-3 text-[#333] text-[10px] uppercase tracking-[3px] animate-bounce pointer-events-none"
        aria-hidden="true"
    >
        <span class="block bg-[#333] w-px h-6"></span>
        Scroll
    </div>
</section>
